{
  "expo": {
    "name": "Mova",
    "slug": "Mova",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": true
    },
    "android": {
      "package": "com.gabribezerra.mova",
      "adaptiveIcon": {
        "backgroundColor": "#071661",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.HIGH_SAMPLING_RATE_SENSORS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#070b19",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O Mova precisa da localização para informar o responsável onde ocorreu uma possível queda.",
          "locationWhenInUsePermission": "O Mova precisa da localização para informar o responsável onde ocorreu uma possível queda."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "O Mova usa os sensores de movimento para detectar quedas."
        }
      ]
    ]
  }
}
